{
  "name": "open-commander",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name open-commander",
    "deploy": "wrangler deploy",
    "deploy:worker": "npm run build && wrangler deploy",
    "deploy:preview": "wrangler versions upload"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "lucide-react": "1.16.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "overrides": {
    "exceljs": {
      "archiver": "8.0.0",
      "fast-csv": "5.0.7",
      "unzipper": "0.12.3",
      "uuid": "11.1.1"
    },
    "ws": "8.20.1"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7",
    "wrangler": "4.84.1"
  }
}
